    "react-dom": "^19.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@ryu/config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
